{
  "name": "uweb-cp",
  "version": "0.0.0",
  "description": "Micro Web Context Provider - hand structured context to a consumer LLM app and get structured data back, using Web standards only.",
  "keywords": [
    "clipboard",
    "context",
    "llm",
    "pwa",
    "structured-output",
    "web-share"
  ],
  "homepage": "https://kuu13580.github.io/uweb-cp/",
  "bugs": "https://github.com/kuu13580/uweb-cp/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuu13580/uweb-cp.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transports": {
      "types": "./dist/transports/index.d.ts",
      "default": "./dist/transports/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}
